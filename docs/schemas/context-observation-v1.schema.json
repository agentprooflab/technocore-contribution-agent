{
  "$id": "https://agentprooflab.github.io/technocore-contribution-agent/schemas/context-observation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {"type": ["string", "null"]},
    "content_trust": {"const": "untrusted", "type": "string"},
    "created_at": {"type": ["string", "null"]},
    "evidence_id": {"minLength": 1, "type": "string"},
    "excerpt": {"type": "string"},
    "excerpt_status": {"enum": ["complete", "truncated", "withheld_untrusted"]},
    "content_length": {"minimum": 0, "type": "integer"},
    "excerpt_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "kind": {"minLength": 1, "type": "string"},
    "match_reasons": {"items": {"type": "string"}, "type": "array"},
    "priority": {"maximum": 100, "minimum": 0, "type": "integer"},
    "related_evidence_count": {"minimum": 1, "type": "integer"},
    "source": {"minLength": 1, "type": "string"},
    "source_url": {"type": ["string", "null"]}
  },
  "required": ["evidence_id", "source", "kind", "priority", "match_reasons", "excerpt", "excerpt_status", "content_length", "excerpt_sha256", "content_trust", "related_evidence_count"],
  "type": "object"
}
